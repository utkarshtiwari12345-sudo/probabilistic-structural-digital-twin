# Publish compact, reviewable evidence while excluding bulk intermediate data.
!results/metrics/*summary.csv
!results/metrics/*hypothesis_checks.csv
!results/metrics/*validation.csv
!results/metrics/*confirmation_checks.csv
!results/metrics/*recovery_gates.csv
!results/metrics/*manifest.csv
!results/metrics/*calibration.csv
