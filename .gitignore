!results/metrics/*feature_selection.csv
!results/metrics/*channel_mapping.csv
!results/metrics/stage4_identifiability.csv
!results/metrics/stage20_zone_signature_matching.csv
!results/release/
!results/release/**
!figures/*.png

# Pin the small official OpenFAST Stage 17 reference and its provenance.
!data/raw/openfast/
!data/raw/openfast/v5.0.0/
!data/raw/openfast/v5.0.0/PROVENANCE.md
!data/raw/openfast/v5.0.0/5MW_OC3Mnpl_DLL_WTurb_WavesIrr/
